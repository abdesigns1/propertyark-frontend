# Browser key restricted to your production/development HTTP referrers.
# Enable Maps JavaScript API and Places API (New) in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Realtime chat (Socket.IO). Change the event names if the backend uses another contract.
NEXT_PUBLIC_CHAT_SOCKET_URL=https://propertyark-backend.onrender.com
NEXT_PUBLIC_CHAT_SOCKET_PATH=/socket.io
NEXT_PUBLIC_CHAT_SOCKET_TOKEN_KEY=token
NEXT_PUBLIC_CHAT_SOCKET_TOKEN_PREFIX=
NEXT_PUBLIC_CHAT_SOCKET_JOIN_EVENT=join-session
NEXT_PUBLIC_CHAT_SOCKET_LEAVE_EVENT=leave-session
NEXT_PUBLIC_CHAT_SOCKET_MESSAGE_EVENT=new-message
